{
  "id": "/manage/",
  "name": "Alty MSA",
  "short_name": "Alty MSA",
  "description": "Alty MSA (Management System Application): Abellar Realty's management system for properties, clients, transactions, agents and documents.",
  "start_url": "/manage",
