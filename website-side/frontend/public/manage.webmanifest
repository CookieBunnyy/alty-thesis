  "icons": [
    { "src": "/icons/manage-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/manage-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/manage-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/manage-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "url": "/manage/dashboard", "icons": [{ "src": "/icons/manage-192.png", "sizes": "192x192" }] },
    { "name": "Transactions", "url": "/manage/transactions", "icons": [{ "src": "/icons/manage-192.png", "sizes": "192x192" }] },
    { "name": "Document Repository", "short_name": "Documents", "url": "/manage/documents", "icons": [{ "src": "/icons/manage-192.png", "sizes": "192x192" }] }
  ]
}
