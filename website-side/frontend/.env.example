# Main Alty FastAPI server (property data + client transactions)
# Local: http://localhost:8000 · Production (Vercel): your Render URL
VITE_API_URL=http://localhost:8000
# Recommendation chat service (website-side/backend)
VITE_CHAT_API_URL=https://alty-thesis.onrender.com
# Separate domains so the public site and the Management System install as two
# separate apps (both domains point at this same Vercel project). Leave both
# empty locally: everything then stays on one address.
#   VITE_SITE_URL=https://alty-thesis.vercel.app
#   VITE_MSA_URL=https://alty-msa.vercel.app
VITE_SITE_URL=
VITE_MSA_URL=
