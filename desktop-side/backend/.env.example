APP_NAME="Abellar Realty Management System"
# Required. Local PostgreSQL (never commit real credentials).
DATABASE_URL="postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/abellar"
# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="CHANGE_ME"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Supabase (central database + storage). Backend only — never put these in
# the desktop app or the website.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DOCUMENTS_BUCKET="documents"
SUPABASE_MEDIA_BUCKET="documents"
# Push document-derived records to Supabase after each change.
CLOUD_SYNC_ENABLED=true

# File storage: auto (Supabase when configured, else local) | supabase | local
DOCUMENT_STORAGE_BACKEND="auto"
# Used when the backend is "local" (default: desktop-side/backend/storage)
# DOCUMENT_STORAGE_DIR=""
MAX_UPLOAD_MB=25

# OCR: auto | rapidocr | tesseract | none
OCR_ENGINE="auto"
OCR_MIN_TEXT_CHARS=40
FORECAST_MIN_MONTHS=6

# Browser origins allowed to call the API (the website dev server by default)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PUBLIC_SUBMISSIONS_PER_HOUR=20

# Website map routing: osrm (default; car, bicycle, walking) | valhalla
# (car, motorcycle, bicycle, walking) | tomtom (all four modes; car and
# motorcycle times include LIVE TRAFFIC; needs TOMTOM_API_KEY) | none.
# OSRM/Valhalla defaults are the public OpenStreetMap (FOSSGIS) servers.
ROUTING_PROVIDER="osrm"
# OSRM_DRIVING_URL="https://routing.openstreetmap.de/routed-car"
# OSRM_BICYCLE_URL="https://routing.openstreetmap.de/routed-bike"
# OSRM_WALKING_URL="https://routing.openstreetmap.de/routed-foot"
# VALHALLA_URL="https://valhalla1.openstreetmap.de"
ROUTING_TIMEOUT_SECONDS=8
ROUTE_CACHE_SECONDS=1800
LIVE_ROUTE_CACHE_SECONDS=120
# Live traffic heat map: none | tomtom (requires TOMTOM_API_KEY; backend only).
TRAFFIC_PROVIDER="none"
# Free key: https://developer.tomtom.com (Maps/Traffic/Routing APIs).
# For live traffic everywhere set ROUTING_PROVIDER="tomtom" and
# TRAFFIC_PROVIDER="tomtom" with this key.
TOMTOM_API_KEY=""
# Workplace place search (Nominatim)
GEOCODER_URL="https://nominatim.openstreetmap.org"
GEOCODER_USER_AGENT="AltyAbellarRealty/1.0"
GEOCODER_COUNTRY_CODES="ph"
MAP_REQUESTS_PER_MINUTE=60

# Creates the first administrator only when the users table is empty.
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD=""
